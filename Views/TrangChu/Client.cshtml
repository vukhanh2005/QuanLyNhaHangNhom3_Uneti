@{
    Layout = "/Views/Shared/ClientLayout.cshtml";
    ViewData["Title"] = "Trang chủ";
}
@using Microsoft.AspNetCore.Http
<section class="hero" aria-labelledby="welcome-title">
    <div class="hero-copy">
        <p class="eyebrow">CHÀO MỪNG ĐẾN VỚI NHÀ HÀNG</p>
        <h1 id="welcome-title">Bữa ngon.<br />Chuyện vui.<br /><em>Ngồi lại bên nhau.</em></h1>
        <p class="hero-description">Một bữa ăn ngon bắt đầu từ một chỗ ngồi vừa ý. Khám phá thực đơn và tìm bàn phù hợp cho những người bạn yêu quý.</p>
        <div class="hero-actions">
            <a class="button" href="#ban-an">Khám phá bàn ăn <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#thuc-don">Xem thực đơn <span aria-hidden="true">→</span></a>
        </div>
        <p class="hero-note">Dành cho những cuộc hẹn nhỏ và những dịp sum vầy.</p>
    </div>
    <div class="table-art" role="img" aria-label="Minh họa bàn ăn với đĩa sứ, khăn ăn và nhành lá trên nền xanh">
        <span class="art-caption">HẸN NHAU BÊN BÀN ĂN</span>
        <div class="napkin"></div><div class="plate"><div class="plate-center"><span class="leaf leaf-one"></span><span class="leaf leaf-two"></span><span class="leaf leaf-three"></span></div></div>
        <div class="cutlery fork"></div><div class="cutlery knife"></div><div class="glass"></div>
        <span class="art-footnote">Thêm một chỗ ngồi, thêm một niềm vui.</span>
    </div>
</section>
<section id="huong-dan" class="booking-guide" aria-label="Hướng dẫn đặt bàn">
    <div><span class="step">01</span><div><h2>Chọn bàn phù hợp</h2><p>Tra cứu vị trí, loại bàn và số chỗ ngồi.</p></div></div>
    <div><span class="step">02</span><div><h2>Hẹn ngày, chọn giờ</h2><p>Chọn thời gian, số người và ghi chú.</p></div></div>
    <div><span class="step">03</span><div><h2>Theo dõi xác nhận</h2><p>Kiểm tra trạng thái trong phiếu đặt bàn.</p></div></div>
</section>
<section class="discover" aria-labelledby="discover-title">
    <div class="section-heading"><div><p class="eyebrow">DÀNH CHO BẠN</p><h2 id="discover-title">Lên hẹn cho bữa ăn tiếp theo</h2></div><p>Mọi thông tin cho cuộc hẹn, ngay tại đây.</p></div>
    <div class="feature-grid">
        <article id="thuc-don" class="feature-card">
            <span class="card-number">01 / THỰC ĐƠN</span><h3>Hôm nay ăn gì?</h3>
            <p>Khám phá món ăn đang phục vụ, thông tin món và giá bán.</p>
            <div class="availability">Thực đơn đang được chuẩn bị.</div>
        </article>
        <article id="ban-an" class="feature-card feature-card-green">
            <span class="card-number">02 / BÀN ĂN & ĐẶT BÀN</span><h3>Một chỗ ngồi vừa ý</h3>
            <p>Tìm theo tên, vị trí; lọc loại bàn, sức chứa và trạng thái. Xem chi tiết trước khi đặt.</p>
            <div class="availability">Tra cứu và đặt bàn chưa sẵn sàng.</div>
        </article>
        <article id="phieu-dat-ban" class="feature-card">
            <span class="card-number">03 / PHIẾU ĐẶT BÀN</span><h3>Cuộc hẹn của bạn</h3>
            <p>Theo dõi phiếu chờ xác nhận, đã xác nhận và xem thông tin từng cuộc hẹn.</p>
            <div class="availability">Chức năng phiếu đặt bàn đang được chuẩn bị.</div>
        </article>
    </div>
</section>
<div class="personal-grid">
    <section id="lich-su" class="personal-panel" aria-labelledby="history-title">
        <p class="eyebrow">NHỮNG CUỘC HẸN ĐÃ QUA</p><h2 id="history-title">Lịch sử đặt bàn</h2>
        <p>Xem lại các phiếu đã sử dụng và đã hủy của bạn.</p>
        <span class="muted">Lịch sử sẽ hiển thị khi chức năng đặt bàn sẵn sàng.</span>
    </section>
    <section id="tai-khoan" class="personal-panel" aria-labelledby="profile-title">
        <p class="eyebrow">TÀI KHOẢN CỦA BẠN</p><h2 id="profile-title">Thông tin cá nhân</h2>
        @if (Context.Session.GetInt32("MaTaiKhoan") != null)
        {
            <p>Xin chào, <strong>@Context.Session.GetString("HoTen")</strong>.</p>
            <span class="muted">Chức năng xem và cập nhật hồ sơ đang được chuẩn bị.</span>
        }
        else
        {
            <p>Đăng nhập để sử dụng tài khoản của bạn.</p>
            <a class="text-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
        }
    </section>
</div>
