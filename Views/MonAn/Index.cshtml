@model List<QuanLyNhaHang.Models.MonAn>
@using QuanLyNhaHang.Models
@{
    Layout = "/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý món ăn";
    ViewData["Description"] = "Quản lý món ăn, giá bán và trạng thái phục vụ.";
}
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<a class="btn btn-success mb-3" asp-action="Them">Thêm món ăn</a>
<div class="admin-panel table-responsive">
    <table class="table align-middle mb-0">
        <caption class="px-3">Danh sách món ăn: @Model.Count món</caption>
        <thead><tr><th scope="col">Tên món</th><th scope="col">Loại món</th><th scope="col">Đơn giá</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            var serving = item.TrangThai == TrangThaiMonAn.DangPhucVu;
            <tr>
                <th scope="row">@item.TenMon</th>
                <td>@item.LoaiMon</td>
                <td>@item.DonGia.ToString("N2") đ</td>
                <td>@(serving ? "Đang phục vụ" : "Ngừng phục vụ")</td>
                <td><div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet" asp-route-id="@item.MaMon">Chi tiết</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Sua" asp-route-id="@item.MaMon">Sửa</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Xoa" asp-route-id="@item.MaMon">Xóa</a>
                    <form asp-action="CapNhatTrangThai" asp-route-id="@item.MaMon" method="post">
                        <input type="hidden" name="trangThai" value="@(serving ? 0 : 1)" />
                        <button class="btn btn-sm btn-outline-secondary" type="submit">@(serving ? "Ngừng phục vụ" : "Phục vụ lại")</button>
                    </form>
                </div></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center p-4">Chưa có món ăn. Chọn “Thêm món ăn” để bắt đầu.</td></tr>
        }
        </tbody>
    </table>
</div>
