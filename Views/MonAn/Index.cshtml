@model IEnumerable<QuanLyNhaHang.Models.MonAn>

@{
    ViewData["Title"] = "Quản lý món ăn";
}

<div class="container mt-4">

    <h2 class="mb-4">Quản lý món ăn</h2>

    <!-- THÔNG TIN MÓN ĂN -->
    <div class="row mb-4">
        <form id="monAnForm" method="post">

            @Html.AntiForgeryToken()
            <!-- FORM -->
            <div class="col-md-9">
                <div class="card">
                    <div class="card-header">
                        Thông tin món ăn
                    </div>

                    <div class="card-body">
                   
                        <input type="hidden" name="MaMon" id="maMon" value="0"/>

                        <div class="row">
                            <!-- Thông tin món ăn -->
                            <div class="col-md-12">

                                <div class="row g-3">

                                    <div class="col-md-6">
                                        <label class="form-label">Tên món</label>
                                        <input id="tenMon" name="TenMon" class="form-control" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Loại món</label>
                                        <input id="loaiMon" name="LoaiMon" class="form-control" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Đơn giá</label>
                                        <input id="donGia" name="DonGia" type="number" class="form-control" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Trạng thái</label>

                                        <select id="trangThai" name="TrangThai" class="form-select">

                                            <option value="1">
                                                Đang phục vụ
                                            </option>

                                            <option value="0">
                                                Ngừng phục vụ
                                            </option>

                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Mô tả</label>

                                        <textarea id="moTa" name="MoTa" class="form-control" rows="3"></textarea>
                                    </div>

                                </div>

                            </div>
                        </div>
                
                    </div>
                </div>
            </div>

            <!-- Các nút -->
            <div class="col-md-3">

                <div class="d-grid gap-3">
                    <!-- Nút thêm -->
                    <button type="submit" formaction="@Url.Action("Create", "MonAn")" id="btnThem"
                            class="btn btn-success">
                        Thêm
                    </button>

                    <button type="submit" formaction="@Url.Action("Edit", "MonAn")" id="btnSua" class="btn btn-warning">
                        Sửa
                    </button>

                    <button type="submit" formaction="@Url.Action("Delete", "MonAn")" id="btnXoa"
                            class="btn btn-danger">
                        Xóa
                    </button>

                </div>

            </div>
        </form>
    </div>


    <!-- Danh sách món ăn -->
    <div class="card">

        <div class="card-header">
            Danh sách món ăn
        </div>

        <div class="card-body">
            
            <div class="table-responsive">
                <!-- Bảng danh sách món ăn -->
                <table class="table table-striped table-hover" id="monAnTable">

                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Tên món</th>
                            <th>Loại món</th>
                            <th>Đơn giá</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="mon-row" style="cursor: pointer;" data-mamon="@item.MaMon" data-tenmon="@item.TenMon"
                                data-loaimon="@item.LoaiMon" data-dongia="@item.DonGia" data-mota="@item.MoTa"
                                data-trangthai="@((int)item.TrangThai)">

                                <td>@item.MaMon</td>

                                <td>@item.TenMon</td>

                                <td>@item.LoaiMon</td>

                                <td>
                                    @item.DonGia.ToString("N0") đ
                                </td>

                                <td>@item.MoTa</td>

                                <td>
                                    @if ((int)item.TrangThai == 1)
                                    {
                                        <span class="badge bg-success">
                                            Đang phục vụ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Ngừng phục vụ
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
<!-- Sự kiện click vào một dòng trong bảng -->
<script>
document.addEventListener("click", function (e) {
    const row = e.target.closest("#monAnTable .mon-row");

    if (!row) return;

    // Highlight
    document.querySelectorAll("#monAnTable .mon-row")
        .forEach(r => r.classList.remove("table-primary"));

    row.classList.add("table-primary");

    // Đổ dữ liệu vào form
    document.getElementById("maMon").value = row.dataset.mamon;
    document.getElementById("tenMon").value = row.dataset.tenmon;
    document.getElementById("loaiMon").value = row.dataset.loaimon;
    document.getElementById("donGia").value = row.dataset.dongia;
    document.getElementById("moTa").value = row.dataset.mota;
    document.getElementById("trangThai").value = row.dataset.trangthai;
});
</script>
@if (TempData["Message"] != null)
{
    <script>
        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Message"])));
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"])));
    </script>
}
