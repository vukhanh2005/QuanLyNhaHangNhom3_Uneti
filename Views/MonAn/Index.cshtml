@model IEnumerable<QuanLyNhaHang.Models.MonAn>

@{
    ViewData["Title"] = "Quản lý món ăn";
}

<div class="container mt-4">

    <h2 class="mb-4">Quản lý món ăn</h2>

    <!-- THÔNG TIN MÓN ĂN -->
    <div class="row mb-4">

        <!-- FORM -->
        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    Thông tin món ăn
                </div>

                <div class="card-body">

                    <input type="hidden" id="maMon" />

                    <div class="row">

                        <!-- ẢNH -->
                        <div class="col-md-4 text-center">

                            <img id="previewImage"
                                 src="/images/monan/no-image.png"
                                 class="img-fluid border rounded mb-2"
                                 style="width: 200px; height: 160px; object-fit: cover;" />

                            <input type="file"
                                   id="imageFile"
                                   name="imageFile"
                                   class="form-control"
                                   accept="image/*" />

                        </div>

                        <!-- Thông tin món ăn -->
                        <div class="col-md-8">

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">Tên món</label>
                                    <input id="tenMon"
                                           name="TenMon"
                                           class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Loại món</label>
                                    <input id="loaiMon"
                                           name="LoaiMon"
                                           class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Đơn giá</label>
                                    <input id="donGia"
                                           name="DonGia"
                                           type="number"
                                           class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Trạng thái</label>

                                    <select id="trangThai"
                                            name="TrangThai"
                                            class="form-select">

                                        <option value="1">
                                            Đang phục vụ
                                        </option>

                                        <option value="0">
                                            Ngừng phục vụ
                                        </option>

                                    </select>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Mô tả</label>

                                    <textarea id="moTa"
                                              name="MoTa"
                                              class="form-control"
                                              rows="3"></textarea>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Các nút -->
        <div class="col-md-3">

            <div class="d-grid gap-3">
                <!-- Nút thêm -->
                <button type="button"
                        id="btnThem"
                        class="btn btn-success">
                    Thêm
                </button>
                <!-- Nút sửa -->
                <button type="button"
                        id="btnSua"
                        class="btn btn-warning">
                    Sửa
                </button>
                <!-- Nút xóa -->
                <button type="button"
                        id="btnXoa"
                        class="btn btn-danger">
                    Xóa
                </button>

            </div>

        </div>

    </div>


    <!-- Danh sách món ăn -->
    <div class="card">

        <div class="card-header">
            Danh sách món ăn
        </div>

        <div class="card-body">
            <form  id="monAnForm" enctype="multipart/form-data">@Html.AntiForgeryToken()
            <div class="table-responsive">
                <!-- Bảng danh sách món ăn -->
                <table class="table table-striped table-hover"
                       id="monAnTable">

                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Ảnh</th>
                            <th>Tên món</th>
                            <th>Loại món</th>
                            <th>Đơn giá</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="mon-row"
                                style="cursor: pointer;"
                                data-mamon="@item.MaMon"
                                data-tenmon="@item.TenMon"
                                data-loaimon="@item.LoaiMon"
                                data-dongia="@item.DonGia"
                                data-mota="@item.MoTa"
                                data-hinhanh="@item.HinhAnh"
                                data-trangthai="@((int)item.TrangThai)">

                                <td>@item.MaMon</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                    {
                                        <img src="/images/monan/@item.HinhAnh"
                                             width="70"
                                             height="55"
                                             style="object-fit: cover;"
                                             class="rounded" />
                                    }
                                    else
                                    {
                                        <span>Chưa có ảnh</span>
                                    }
                                </td>

                                <td>@item.TenMon</td>

                                <td>@item.LoaiMon</td>

                                <td>
                                    @item.DonGia.ToString("N0") đ
                                </td>

                                <td>@item.MoTa</td>

                                <td>
                                    @if ((int)item.TrangThai == 1)
                                    {
                                        <span class="badge bg-success">
                                            Đang phục vụ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Ngừng phục vụ
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
            </form>
        </div>
    </div>

</div>
<!-- Sự kiện click vào một dòng trong bảng -->
<script>
    $(document).ready(function () {

        // Click vào một dòng trong bảng
        $(".mon-row").click(function () {

            // Bỏ highlight dòng cũ
            $(".mon-row").removeClass("table-primary");

            // Highlight dòng đang chọn
            $(this).addClass("table-primary");

            // Lấy dữ liệu từ dòng
            $("#maMon").val($(this).data("mamon"));
            $("#tenMon").val($(this).data("tenmon"));
            $("#loaiMon").val($(this).data("loaimon"));
            $("#donGia").val($(this).data("dongia"));
            $("#moTa").val($(this).data("mota"));
            $("#trangThai").val($(this).data("trangthai"));

            // Lấy ảnh
            let hinhAnh = $(this).data("hinhanh");

            if (hinhAnh) {
                $("#previewImage").attr(
                    "src",
                    "/images/monan/" + hinhAnh
                );
            } else {
                $("#previewImage").attr(
                    "src",
                    "/images/monan/no-image.png"
                );
            }
        });


        // Xem trước ảnh khi chọn file
        $("#imageFile").change(function () {

            let file = this.files[0];

            if (file) {
                let imageUrl = URL.createObjectURL(file);

                $("#previewImage").attr("src", imageUrl);
            }
        });

    });
</script>