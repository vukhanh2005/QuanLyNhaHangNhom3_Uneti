@model QuanLyNhaHang.ViewModels.Module04.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Module 4";
}

<div class="container-fluid py-4">
    <h2 class="fw-bold mb-1">Tổng quan nhà hàng</h2>
    <p class="text-muted mb-4">Tình hình hoạt động và đặt bàn của nhà hàng</p>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Tổng số loại bàn</p>
                <h2>@Model.TongSoLoaiBan</h2>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Tổng số bàn</p>
                <h2>@Model.TongSoBan</h2>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Tổng số món ăn</p>
                <h2>@Model.TongSoMonAn</h2>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Tổng số khách hàng</p>
                <h2>@Model.TongSoKhachHang</h2>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Tổng phiếu đặt bàn</p>
                <h2>@Model.TongSoPhieuDatBan</h2>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Phiếu chờ xác nhận</p>
                <h2 class="text-warning">@Model.SoPhieuChoXacNhan</h2>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Phiếu đã xác nhận</p>
                <h2 class="text-primary">@Model.SoPhieuDaXacNhan</h2>
            </div></div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <p class="text-muted">Bàn đang sử dụng</p>
                <h2 class="text-success">@Model.SoBanDangSuDung</h2>
            </div></div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>Bàn theo loại</h5></div>
                <div class="card-body">
                    @if (!Model.SoBanTheoLoai.Any())
                    {
                        <p class="text-muted">Chưa có dữ liệu.</p>
                    }
                    @foreach (var item in Model.SoBanTheoLoai)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span>@item.Nhom</span>
                            <strong>@item.SoLuong bàn</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>Bàn theo trạng thái</h5></div>
                <div class="card-body">
                    @if (!Model.SoBanTheoTrangThai.Any())
                    {
                        <p class="text-muted">Chưa có dữ liệu.</p>
                    }
                    @foreach (var item in Model.SoBanTheoTrangThai)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span>@item.Nhom</span>
                            <strong>@item.SoLuong bàn</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a asp-controller="PhieuDatBan" asp-action="Index" class="btn btn-primary">
            Quản lý phiếu đặt bàn
        </a>
        <a asp-controller="SuDungBan" asp-action="Index" class="btn btn-success">
            Sử dụng bàn
        </a>
        <a asp-controller="Statistics" asp-action="Index" class="btn btn-outline-primary">
            Xem thống kê
        </a>
    </div>
</div>
