 @model QuanLyNhaHang.ViewModels.Module04.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Module 4";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Tổng quan nhà hàng</h2>
        <p class="text-muted mb-0">Tổng hợp tình trạng bàn ăn và số lượng món ăn</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Tổng số bàn</p>
                    <h2 class="fw-bold mb-0">@Model.TongSoBan</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Tổng số món ăn</p>
                    <h2 class="fw-bold mb-0">@Model.TongSoMonAn</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Bàn đang sử dụng</p>
                    <h2 class="fw-bold text-primary mb-0">@Model.SoBanDangSuDung</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Bàn sẵn sàng</p>
                    <h2 class="fw-bold text-success mb-0">@Model.SoBanSanSang</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Thống kê bàn theo loại</h5>
                </div>
                <div class="card-body">
                    @if (Model.SoBanTheoLoai.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu bàn ăn.</p>
                    }
                    else
                    {
                        @foreach (var item in Model.SoBanTheoLoai)
                        {
                            int phanTram = Model.TongSoBan > 0
                                ? item.SoLuong * 100 / Model.TongSoBan
                                : 0;

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>@item.Nhom</span>
                                    <strong>@item.SoLuong bàn (@phanTram%)</strong>
                                </div>
                                <div class="progress" role="progressbar"
                                     aria-valuenow="@phanTram"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <div class="progress-bar"
                                         style="width: @phanTram%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Thống kê bàn theo trạng thái</h5>
                </div>
                <div class="card-body">
                    @if (Model.SoBanTheoTrangThai.Count == 0)
                    {
                        <p class="text-muted mb-0">Chưa có dữ liệu trạng thái bàn.</p>
                    }
                    else
                    {
                        @foreach (var item in Model.SoBanTheoTrangThai)
                        {
                            int phanTram = Model.TongSoBan > 0
                                ? item.SoLuong * 100 / Model.TongSoBan
                                : 0;

                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>@(string.IsNullOrWhiteSpace(item.Nhom) ? "Chưa xác định" : item.Nhom)</span>
                                    <strong>@item.SoLuong bàn (@phanTram%)</strong>
                                </div>
                                <div class="progress" role="progressbar"
                                     aria-valuenow="@phanTram"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <div class="progress-bar bg-success"
                                         style="width: @phanTram%"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="PhieuDatBan"
           asp-action="Index"
           class="btn btn-primary">
            Quản lý phiếu đặt bàn
        </a>

        <a asp-controller="Statistics"
           asp-action="Index"
           class="btn btn-outline-primary ms-2">
            Xem thống kê chi tiết
        </a>
    </div>
</div>