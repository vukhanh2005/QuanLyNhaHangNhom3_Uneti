
@model QuanLyNhaHang.ViewModels.Module04.StatisticsViewModel

@{
    ViewData["Title"] = "Thống kê";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Thống kê nhà hàng</h2>
            <p class="text-muted mb-0">
                Tổng quan tình hình bàn ăn, món ăn và phiếu đặt bàn
            </p>
        </div>
    </div>

    <!-- Các thẻ tổng quan -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted mb-2">Tổng số bàn</div>
                    <h2 class="fw-bold text-primary mb-0">
                        @Model.TongSoBan
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted mb-2">Tổng số món ăn</div>
                    <h2 class="fw-bold text-success mb-0">
                        @Model.TongSoMonAn
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted mb-2">
                        Tổng số phiếu đặt bàn
                    </div>
                    <h2 class="fw-bold text-warning mb-0">
                        @Model.TongSoPhieuDatBan
                    </h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê bàn theo loại -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Số bàn theo loại bàn</h5>
        </div>

        <div class="card-body">
            @if (Model.SoBanTheoLoai.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Loại bàn</th>
                                <th class="text-end">Số lượng bàn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sttLoai = 1;
                            }
                            @foreach (var item in Model.SoBanTheoLoai)
                            {
                                <tr>
                                    <td>@sttLoai</td>
                                    <td>@item.Nhom</td>
                                    <td class="text-end fw-semibold">
                                        @item.SoLuong
                                    </td>
                                </tr>
                                sttLoai++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Chưa có dữ liệu bàn ăn.
                </p>
            }
        </div>
    </div>

    <!-- Thống kê bàn theo trạng thái -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Số bàn theo trạng thái</h5>
        </div>

        <div class="card-body">
            @if (Model.SoBanTheoTrangThai.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Số lượng bàn</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sttTrangThai = 1;
                            }
                            @foreach (var item in Model.SoBanTheoTrangThai)
                            {
                                <tr>
                                    <td>@sttTrangThai</td>
                                    <td>@item.Nhom</td>
                                    <td class="text-end fw-semibold">
                                        @item.SoLuong
                                    </td>
                                </tr>
                                sttTrangThai++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Chưa có dữ liệu trạng thái bàn.
                </p>
            }
        </div>
    </div>

    <!-- Thống kê phiếu đặt bàn theo trạng thái -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Phiếu đặt bàn theo trạng thái
            </h5>
        </div>

        <div class="card-body">
            @if (Model.PhieuDatBanTheoTrangThai.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Trạng thái phiếu</th>
                                <th class="text-end">Số lượng phiếu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sttPhieu = 1;
                            }
                            @foreach (var item in Model.PhieuDatBanTheoTrangThai)
                            {
                                <tr>
                                    <td>@sttPhieu</td>
                                    <td>@item.Nhom</td>
                                    <td class="text-end fw-semibold">
                                        @item.SoLuong
                                    </td>
                                </tr>
                                sttPhieu++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    Chưa có dữ liệu phiếu đặt bàn.
                </p>
            }
        </div>
    </div>
</div>
