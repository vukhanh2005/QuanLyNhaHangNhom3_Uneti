@model QuanLyNhaHang.ViewModels.Module04.StatisticsViewModel

@{
    ViewData["Title"] = "Thống kê nhà hàng";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold">Thống kê nhà hàng</h2>
            <p class="text-muted">Phân tích tình hình bàn ăn và hoạt động đặt bàn</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">
            Quay lại Dashboard
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm"><div class="card-body">
                <p class="text-muted">Tổng số bàn</p>
                <h2>@Model.TongSoBan</h2>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm"><div class="card-body">
                <p class="text-muted">Tổng số món ăn</p>
                <h2>@Model.TongSoMonAn</h2>
            </div></div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm"><div class="card-body">
                <p class="text-muted">Tổng số phiếu đặt bàn</p>
                <h2>@Model.TongSoPhieuDatBan</h2>
            </div></div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>1. Số bàn theo loại bàn</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.SoBanTheoLoai)
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>2. Số bàn theo trạng thái</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.SoBanTheoTrangThai)
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>3. Phiếu đặt bàn theo trạng thái</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.PhieuDatBanTheoTrangThai)
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>4. Số lượt đặt theo từng bàn</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.PhieuTheoBan)
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>5. Số lượt đặt theo loại bàn</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.PhieuTheoLoaiBan)
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>6. Bàn được đặt nhiều nhất</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.BanDuocDatNhieuNhat)
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>7. Số lượt đặt theo khách hàng (Top 20)</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.PhieuTheoKhachHang)
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white"><h5>8. Số lượt đặt theo tháng</h5></div>
                <div class="card-body">
                    @await Html.PartialAsync("~/Views/Module04/Statistics/_ThongKeBang.cshtml", Model.PhieuTheoThang)
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="PhieuDatBan" asp-action="Index" class="btn btn-primary">
            Quản lý phiếu đặt bàn
        </a>
    </div>
</div>
