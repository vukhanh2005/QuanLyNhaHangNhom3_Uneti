@model QuanLyNhaHang.ViewModels.Module04.StatisticsViewModel

@{
    ViewData["Title"] = "Thống kê Module 4";
}

<div class="container mt-4">

    <h2 class="mb-4">Thống kê quản lý nhà hàng</h2>

    <!-- Tổng quan -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Tổng số bàn</h6>
                    <h2>@Model.TongSoBan</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Tổng số món ăn</h6>
                    <h2>@Model.TongSoMonAn</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- Thống kê số bàn theo loại -->
        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>Số bàn theo loại</strong>
                </div>

                <div class="card-body">

                    @if (Model.SoBanTheoLoai.Any())
                    {
                        <table class="table table-bordered table-hover">

                            <thead>
                                <tr>
                                    <th>Loại bàn</th>
                                    <th>Số lượng</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.SoBanTheoLoai)
                                {
                                    <tr>
                                        <td>@item.Nhom</td>
                                        <td>@item.SoLuong</td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            Chưa có dữ liệu bàn theo loại.
                        </p>
                    }

                </div>

            </div>

        </div>

        <!-- Thống kê số bàn theo trạng thái -->
        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>Số bàn theo trạng thái</strong>
                </div>

                <div class="card-body">

                    @if (Model.SoBanTheoTrangThai.Any())
                    {
                        <table class="table table-bordered table-hover">

                            <thead>
                                <tr>
                                    <th>Trạng thái</th>
                                    <th>Số lượng</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model.SoBanTheoTrangThai)
                                {
                                    <tr>
                                        <td>@item.Nhom</td>
                                        <td>@item.SoLuong</td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            Chưa có dữ liệu bàn theo trạng thái.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>