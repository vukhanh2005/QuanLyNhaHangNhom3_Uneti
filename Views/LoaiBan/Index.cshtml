@model List<LoaiBan>
@{
    Layout = "/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý loại bàn";
    ViewData["Description"] = "Quản lý danh mục, mô tả và trạng thái các loại bàn trong nhà hàng.";
}
@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
<a class="btn btn-success mb-3" asp-action="Them">Thêm loại bàn</a>
<div class="admin-panel table-responsive">
    <table class="table align-middle mb-0">
        <caption class="px-3">Danh sách loại bàn: @Model.Count loại</caption>
        <thead><tr><th scope="col">Tên loại bàn</th><th scope="col">Mô tả</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <th scope="row">@item.TenLoaiBan</th><td class="text-break">@item.MoTa</td>
                    <td>@(item.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="ChiTiet" asp-route-id="@item.MaLoaiBan" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            <a asp-action="Sua" asp-route-id="@item.MaLoaiBan" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Xoa" asp-route-id="@item.MaLoaiBan" class="btn btn-sm btn-outline-danger">Xóa</a>
                            <form asp-action="CapNhatTrangThai" asp-route-id="@item.MaLoaiBan" method="post">
                                <input type="hidden" name="trangThai" value="@((!item.TrangThai).ToString().ToLowerInvariant())" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">@(item.TrangThai ? "Ngừng hoạt động" : "Kích hoạt")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center p-4">Chưa có loại bàn. Chọn “Thêm loại bàn” để bắt đầu.</td></tr>
            }
        </tbody>
    </table>
</div>
