@model List<QuanLyNhaHang.DTO.KhachHangResponse>
@{
    Layout = "/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý khách hàng";
    ViewData["Description"] = "Tra cứu thông tin và quản lý trạng thái hồ sơ khách hàng.";
    var tuKhoa = ViewData["TuKhoa"] as string;
    var trangThai = ViewData["TrangThai"] as bool?;
    var filtered = !string.IsNullOrWhiteSpace(tuKhoa) || trangThai.HasValue;
}
@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<form asp-action="Index" method="get" class="admin-panel p-3 mb-3" role="search" aria-label="Tìm khách hàng">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6">
            <label for="tuKhoa" class="form-label">Tìm khách hàng</label>
            <input type="search" id="tuKhoa" name="tuKhoa" value="@tuKhoa" class="form-control"
                   placeholder="Họ tên, email hoặc số điện thoại" />
        </div>
        <div class="col-12 col-md-3">
            <label for="trangThai" class="form-label">Trạng thái hồ sơ</label>
            <select id="trangThai" name="trangThai" class="form-select">
                <option value="" selected="@(!trangThai.HasValue)">Tất cả trạng thái</option>
                <option value="true" selected="@(trangThai == true)">Hoạt động</option>
                <option value="false" selected="@(trangThai == false)">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-success">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
        </div>
    </div>
</form>
<div class="admin-panel table-responsive">
    <table class="table align-middle mb-0">
        <caption class="px-3">@(filtered ? "Kết quả tìm kiếm" : "Danh sách khách hàng"): @Model.Count khách hàng</caption>
        <thead><tr>
            <th scope="col">Mã KH</th><th scope="col">Họ tên</th><th scope="col">Số điện thoại</th>
            <th scope="col">Email</th><th scope="col">Ngày đăng ký</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaKhachHang</td>
                <th scope="row">@item.HoTen</th>
                <td>@item.SoDienThoai</td>
                <td class="text-break">@item.Email</td>
                <td class="text-nowrap">@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                <td><span class="badge @(item.TrangThai ? "text-bg-success" : "text-bg-secondary")">@(item.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</span></td>
                <td><div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet" asp-route-id="@item.MaKhachHang"
                       asp-route-tuKhoa="@tuKhoa" asp-route-locTrangThai="@trangThai">Chi tiết</a>
                    <form asp-action="CapNhatTrangThai" asp-route-id="@item.MaKhachHang" method="post">
                        <input type="hidden" name="trangThai" value="@((!item.TrangThai).ToString().ToLowerInvariant())" />
                        <input type="hidden" name="tuKhoa" value="@tuKhoa" />
                        <input type="hidden" name="locTrangThai" value="@(trangThai?.ToString().ToLowerInvariant())" />
                        <button class="btn btn-sm btn-outline-primary" type="submit">@(item.TrangThai ? "Ngừng hoạt động" : "Kích hoạt")</button>
                    </form>
                </div></td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center p-4">@(filtered ? "Không tìm thấy khách hàng phù hợp. Hãy đổi từ khóa hoặc xóa bộ lọc." : "Chưa có hồ sơ khách hàng.")</td></tr>
        }
        </tbody>
    </table>
</div>
