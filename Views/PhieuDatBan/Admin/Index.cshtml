@model QuanLyNhaHang.ViewModels.Module04.PhieuDatBanViewModel

@{
    ViewData["Title"] = "Quản lý phiếu đặt bàn";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý phiếu đặt bàn</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Tìm kiếm và lọc phiếu đặt bàn</strong>
        </div>

        <div class="card-body">
            <form asp-controller="PhieuDatBan"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Tên khách hàng</label>
                        <input name="tenKhachHang"
                               value="@Model.TenKhachHang"
                               class="form-control"
                               placeholder="Nhập tên khách hàng" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Tên bàn</label>
                        <input name="tenBan"
                               value="@Model.TenBan"
                               class="form-control"
                               placeholder="Nhập tên bàn" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Trạng thái</label>
                        <select name="trangThai" class="form-select">
                            <option value="">Tất cả trạng thái</option>

                            <option value="Chờ xác nhận"
                                selected="@(Model.TrangThai == "Chờ xác nhận")">
                                Chờ xác nhận
                            </option>

                            <option value="Đã xác nhận"
                                selected="@(Model.TrangThai == "Đã xác nhận")">
                                Đã xác nhận
                            </option>

                            <option value="Đang sử dụng"
                                selected="@(Model.TrangThai == "Đang sử dụng")">
                                Đang sử dụng
                            </option>

                            <option value="Đã sử dụng"
                                selected="@(Model.TrangThai == "Đã sử dụng")">
                                Đã sử dụng
                            </option>

                            <option value="Đã hủy"
                                selected="@(Model.TrangThai == "Đã hủy")">
                                Đã hủy
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Ngày đặt</label>
                        <input type="date"
                               name="ngaySuDung"
                               value="@(Model.NgaySuDung?.ToString("yyyy-MM-dd"))"
                               class="form-control" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        Tìm kiếm
                    </button>

                    <a asp-controller="PhieuDatBan"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách phiếu -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between">
            <strong>Danh sách phiếu đặt bàn</strong>
            <span>
                Tổng số: @(Model.DanhSachPhieuDatBan?.Count ?? 0) phiếu
            </span>
        </div>

        <div class="card-body">
            @if (Model.DanhSachPhieuDatBan == null ||
                 !Model.DanhSachPhieuDatBan.Any())
            {
                <div class="alert alert-info text-center">
                    Chưa có phiếu đặt bàn nào.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Khách hàng</th>
                                <th>Bàn ăn</th>
                                <th>Ngày giờ đặt</th>
                                <th>Số người</th>
                                <th>Trạng thái</th>
                                <th style="min-width: 280px">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.DanhSachPhieuDatBan)
                            {
                                <tr>
                                    <td>@item.MaPhieuDatBan</td>

                                    <td>
                                        @(item.KhachHang?.HoTen ?? "Không xác định")
                                    </td>

                                    <td>
                                        @(item.BanAn?.TenBan ?? "Chưa có bàn")
                                    </td>

                                    <td>
                                        @item.NgayGioDat.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>@item.SoNguoi</td>

                                    <td>
                                        @switch (item.TrangThai)
                                        {
                                            case "Chờ xác nhận":
                                                <span class="badge bg-warning text-dark">
                                                    Chờ xác nhận
                                                </span>
                                                break;

                                            case "Đã xác nhận":
                                                <span class="badge bg-success">
                                                    Đã xác nhận
                                                </span>
                                                break;

                                            case "Đang sử dụng":
                                                <span class="badge bg-primary">
                                                    Đang sử dụng
                                                </span>
                                                break;

                                            case "Đã sử dụng":
                                                <span class="badge bg-secondary">
                                                    Đã sử dụng
                                                </span>
                                                break;

                                            case "Đã hủy":
                                                <span class="badge bg-danger">
                                                    Đã hủy
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-dark">
                                                    @item.TrangThai
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-controller="PhieuDatBan"
                                               asp-action="Details"
                                               asp-route-id="@item.MaPhieuDatBan"
                                               class="btn btn-info btn-sm text-white">
                                                Chi tiết
                                            </a>

                                            @if (item.TrangThai == "Chờ xác nhận")
                                            {
                                                <form asp-controller="PhieuDatBan"
                                                      asp-action="XacNhan"
                                                      method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.MaPhieuDatBan" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Xác nhận
                                                    </button>
                                                </form>

                                                <form asp-controller="PhieuDatBan"
                                                      asp-action="Huy"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.MaPhieuDatBan" />

                                                    <button type="submit"
                                                            class="btn btn-warning btn-sm">
                                                        Hủy
                                                    </button>
                                                </form>
                                            }

                                            @if (item.TrangThai != "Đang sử dụng")
                                            {
                                                <form asp-controller="PhieuDatBan"
                                                      asp-action="Xoa"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiếu này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.MaPhieuDatBan" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm">
                                                        Xóa
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
