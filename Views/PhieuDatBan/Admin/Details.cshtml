@model QuanLyNhaHang.Models.PhieuDatBan

@{
    ViewData["Title"] = "Chi tiết phiếu đặt bàn";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chi tiết phiếu đặt bàn</h2>

        <a asp-controller="PhieuDatBan"
           asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Thông tin phiếu #@Model.MaPhieuDatBan</strong>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Mã phiếu:</strong> @Model.MaPhieuDatBan</p>
                    <p><strong>Khách hàng:</strong> @Model.KhachHang?.HoTen</p>
                    <p><strong>Số điện thoại:</strong> @Model.KhachHang?.SoDienThoai</p>
                    <p><strong>Email:</strong> @Model.KhachHang?.Email</p>
                </div>

                <div class="col-md-6">
                    <p><strong>Bàn ăn:</strong> @Model.BanAn?.TenBan</p>
                    <p><strong>Loại bàn:</strong> @Model.BanAn?.LoaiBan?.TenLoaiBan</p>
                    <p>
                        <strong>Ngày giờ đặt:</strong>
                        @Model.NgayGioDat.ToString("dd/MM/yyyy HH:mm")
                    </p>
                    <p><strong>Số người:</strong> @Model.SoNguoi</p>
                </div>
            </div>

            <hr />

            <p>
                <strong>Trạng thái:</strong>
                <span class="badge bg-primary">
                    @Model.TrangThai
                </span>
            </p>

            <p>
                <strong>Ghi chú:</strong>
                @(string.IsNullOrWhiteSpace(Model.GhiChu)
                    ? "Không có"
                    : Model.GhiChu)
            </p>

            <p>
                <strong>Ngày tạo phiếu:</strong>
                @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>

        <div class="card-footer">
            <div class="d-flex flex-wrap gap-2">
                @if (Model.TrangThai == "Chờ xác nhận")
                {
                    <form asp-action="XacNhan"
                          asp-controller="PhieuDatBan"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="id"
                               value="@Model.MaPhieuDatBan" />

                        <button type="submit"
                                class="btn btn-success">
                            Xác nhận phiếu
                        </button>
                    </form>

                    <form asp-action="Huy"
                          asp-controller="PhieuDatBan"
                          method="post"
                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="id"
                               value="@Model.MaPhieuDatBan" />

                        <button type="submit"
                                class="btn btn-warning">
                            Hủy phiếu
                        </button>
                    </form>
                }

                @if (Model.TrangThai == "Đã xác nhận")
                {
                    <form asp-action="BatDauSuDung"
                          asp-controller="PhieuDatBan"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="id"
                               value="@Model.MaPhieuDatBan" />

                        <button type="submit"
                                class="btn btn-primary">
                            Bắt đầu sử dụng
                        </button>
                    </form>

                    <form asp-action="Huy"
                          asp-controller="PhieuDatBan"
                          method="post"
                          onsubmit="return confirm('Bạn có chắc chắn muốn hủy phiếu này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="id"
                               value="@Model.MaPhieuDatBan" />

                        <button type="submit"
                                class="btn btn-warning">
                            Hủy phiếu
                        </button>
                    </form>
                }

                @if (Model.TrangThai == "Đang sử dụng")
                {
                    <form asp-action="KetThucSuDung"
                          asp-controller="PhieuDatBan"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="id"
                               value="@Model.MaPhieuDatBan" />

                        <button type="submit"
                                class="btn btn-success">
                            Kết thúc sử dụng
                        </button>
                    </form>
                }

                @if (Model.TrangThai != "Đang sử dụng")
                {
                    <form asp-action="Xoa"
                          asp-controller="PhieuDatBan"
                          method="post"
                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiếu này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="id"
                               value="@Model.MaPhieuDatBan" />

                        <button type="submit"
                                class="btn btn-danger">
                            Xóa phiếu
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
