@* Họ và tên: Vi Thái Học
   Mã sinh viên: 23103100054
   Nội dung thực hiện: Giao diện thêm bàn ăn và hiển thị lỗi validation. *@
@model QuanLyNhaHang.ViewModels.BanAnFormViewModel
@{ ViewData["Title"] = "Thêm bàn ăn"; }
<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Thêm bàn</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
