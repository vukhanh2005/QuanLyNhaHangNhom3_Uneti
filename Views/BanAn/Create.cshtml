@* Họ và tên: Vi Thái Học
   Mã sinh viên: [ĐIỀN MÃ SINH VIÊN]
   Nội dung thực hiện: Quản lý bàn ăn, tìm kiếm, lọc, sắp xếp và phân trang. *@
@model QuanLyNhaHang.ViewModels.BanAnFormViewModel
@{ ViewData["Title"] = "Thêm bàn ăn"; }
<h1>Thêm bàn ăn</h1>
<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Thêm bàn</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

