@* Họ và tên: Vi Thái Học
   Mã sinh viên: 23103100054
   Nội dung thực hiện: Hiển thị danh sách bàn ăn, tìm kiếm, lọc, sắp xếp và phân trang. *@
@model QuanLyNhaHang.ViewModels.BanAnIndexViewModel
@using QuanLyNhaHang.Filters
@{
    ViewData["Title"] = "Quản lý bàn ăn";
    var isAdmin = Module2AdminAttribute.IsAdmin(Context.Session);
    var routes = new Dictionary<string, string> {
        ["keyword"] = Model.Keyword ?? "", ["maLoaiBan"] = Model.MaLoaiBan?.ToString() ?? "",
        ["soChoNgoi"] = Model.SoChoNgoi?.ToString() ?? "", ["trangThai"] = Model.TrangThai ?? "",
        ["sortOrder"] = Model.SortOrder
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý bàn ăn</h1>
    @if (isAdmin) { <a asp-action="Create" class="btn btn-primary">+ Thêm bàn</a> }
</div>
@if (TempData["BanAnSuccess"] is string message) {
    <div class="alert alert-success" role="status">@message</div>
}
<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Keyword" class="form-label">Tên bàn hoặc vị trí</label>
            <input asp-for="Keyword" class="form-control" placeholder="Ví dụ: Bàn 01, Tầng 2" />
        </div>
        <div class="col-md-4">
            <label asp-for="MaLoaiBan" class="form-label">Loại bàn</label>
            <select asp-for="MaLoaiBan" asp-items="Model.LoaiBanOptions" class="form-select"><option value="">Tất cả</option></select>
        </div>
        <div class="col-md-4">
            <label asp-for="SoChoNgoi" class="form-label">Số chỗ ngồi</label>
            <select asp-for="SoChoNgoi" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var seat in Model.SoChoOptions) { <option value="@seat">@seat chỗ</option> }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="TrangThai" class="form-label">Trạng thái</label>
            <select asp-for="TrangThai" asp-items="Model.TrangThaiOptions" class="form-select"><option value="">Tất cả</option></select>
        </div>
        <div class="col-md-4">
            <label asp-for="SortOrder" class="form-label">Sắp xếp</label>
            <select asp-for="SortOrder" class="form-select">
                <option value="name_asc">Tên bàn A → Z</option><option value="name_desc">Tên bàn Z → A</option>
                <option value="seat_asc">Số chỗ tăng dần</option><option value="seat_desc">Số chỗ giảm dần</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button class="btn btn-primary" type="submit">Tìm kiếm / Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>
<p role="status">Tìm thấy @Model.TotalCount bàn.</p>
<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead><tr><th>Mã bàn</th><th>Tên bàn</th><th>Loại bàn</th><th>Số chỗ</th><th>Vị trí</th><th>Trạng thái</th><th>Chức năng</th></tr></thead>
    <tbody>
    @foreach (var item in Model.BanAns) {
        <tr>
            <td>@item.MaBan</td><td>@item.TenBan</td><td>@item.LoaiBan.TenLoaiBan</td>
            <td>@item.SoChoNgoi</td><td>@item.ViTri</td><td>@item.TrangThai</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.MaBan" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                @if (isAdmin) {
                    <a asp-action="Edit" asp-route-id="@item.MaBan" class="btn btn-sm btn-outline-secondary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.MaBan" class="btn btn-sm btn-outline-danger">Xóa</a>
                }
            </td>
        </tr>
    }
    @if (Model.BanAns.Count == 0) {
        <tr><td colspan="7" class="text-center py-4">Không có bàn phù hợp. Hãy đổi điều kiện hoặc chọn Reset.</td></tr>
    }
    </tbody>
</table>
</div>
<nav aria-label="Phân trang bàn ăn">
    <ul class="pagination flex-wrap">
        @if (Model.CurrentPage > 1) {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="@(Model.CurrentPage - 1)">Trước</a></li>
        } else { <li class="page-item disabled"><span class="page-link">Trước</span></li> }
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++) {
            @if (pageNumber == Model.CurrentPage) {
                <li class="page-item active"><span class="page-link" aria-current="page">@pageNumber</span></li>
            } else {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="@pageNumber">@pageNumber</a></li>
            }
        }
        @if (Model.CurrentPage < Model.TotalPages) {
            <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="routes" asp-route-page="@(Model.CurrentPage + 1)">Sau</a></li>
        } else { <li class="page-item disabled"><span class="page-link">Sau</span></li> }
    </ul>
</nav>
<p>Trang @Model.CurrentPage / @Model.TotalPages</p>

