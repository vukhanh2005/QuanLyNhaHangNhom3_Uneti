@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký tài khoản</title>
    <style>
        label{
            display: inline-block;
            min-width: 120px;
        }
        body{
            margin: 0;
            padding: 24px 12px;
            box-sizing: border-box;
            min-height: 100vh;
            display: flex;

            justify-content: center;
            align-items: center;

        }
        .wrapper{
            border: 2px black solid;
            border-radius: 50px;
            padding: 20px;
            width: 100%;
            max-width: 480px;
            box-sizing: border-box;
            height: fit-content;
        }
        .input-register-box{
            margin-top: 10px;
            margin-bottom: 10px;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .button-box{
            display: flex;
            justify-content: center;
            margin-top: 10px;
        }
        button{
            border-radius: 50px;
            width: 100px;
            height: 50px;
        }
        input, select{
            border-radius: 10px;
            padding-left: 10px;
            min-height: 32px;
            flex: 1;
            min-width: 0;
            box-sizing: border-box;
        }
        .register-form{
            display: flex;
            justify-content: center;
            align-items: center;

            flex-direction: column;
        }
        .success-message{
            color: green;
            font-size: larger;
        }
        .fail-message{
            color: red;
            font-size: larger;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <h1>Đăng ký tài khoản</h1>
        @{
            if(ViewBag.SuccessMessage != null)
            {
                //Dang ki thanh cong thi chuyen huong den trang dang nhap
                <b>
                    <p class="success-message">
                        @ViewBag.SuccessMessage
                    </p>
                </b>
                <script>
                    setTimeout(()=>{
                        window.location.href = '@Url.Action("Login", "Account")';
                    }, 3000)
                </script>
            }
            if(ViewBag.FailMessage != null)
            {
                <b>
                    <p class="fail-message">
                        @ViewBag.FailMessage
                    </p>
                </b>
            }
        }
        <form class="register-form" method="post" asp-controller="Account" asp-action="Register">
            <div class="input-register-box">
                <label for="hoTen">Họ và tên</label>
                <input id="hoTen" required name="hoTen" maxlength="250" autocomplete="name"/>
            </div>
            <div class="input-register-box">
                <label for="email">Email</label>
                <input id="email" type="email" required name="email" maxlength="50" autocomplete="email"/>
            </div>
            <div class="input-register-box">
                <label for="ngaySinh">Ngày sinh</label>
                <input id="ngaySinh" type="date" required name="ngaySinh" max="@DateTime.Today.ToString("yyyy-MM-dd")" autocomplete="bday"/>
            </div>
            <div class="input-register-box">
                <label for="gioiTinh">Giới tính</label>
                <select id="gioiTinh" required name="gioiTinh">
                    <option value="">Chọn giới tính</option>
                    <option value="true">Nam</option>
                    <option value="false">Nữ</option>
                </select>
            </div>
            <div class="input-register-box">
                <label for="soDienThoai">Số điện thoại</label>
                <input id="soDienThoai" type="tel" required name="soDienThoai" autocomplete="tel"/>
            </div>
            <div class="input-register-box">
                <label for="diaChi">Địa chỉ</label>
                <input id="diaChi" required name="diaChi" autocomplete="street-address"/>
            </div>
            <div class="input-register-box">
                <label for="username">Tên đăng nhập</label>
                <input id="username" required name="username" maxlength="50" autocomplete="username"/>
            </div>
            <div class="input-register-box">
                <label for="password">Mật khẩu</label>
                <input id="password" required name="password" type="password" autocomplete="new-password"/>
            </div>
            <div class="input-register-box">
                <label for="confirmPassword">Nhập lại mật khẩu</label>
                <input id="confirmPassword" type="password" required name="confirmPassword" autocomplete="new-password"/>
            </div>
            <div class="button-box">
                <button type="submit">Đăng ký</button>
            </div>
            <p>Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập</a></p>
        </form>
    </div>
</body>
</html>
