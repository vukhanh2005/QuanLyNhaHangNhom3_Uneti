@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Nhà Hàng</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-container auth-container-wide">
        <!-- Quay lại trang chủ -->
        <div class="auth-top-bar">
            <a class="auth-back-link" asp-controller="TrangChu" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Trang chủ
            </a>
        </div>

        <div class="auth-card">
            <!-- Header thương hiệu -->
            <div class="auth-header">
                <a class="auth-brand" asp-controller="TrangChu" asp-action="Index">
                    <span class="auth-brand-mark" aria-hidden="true">N</span>
                    <span class="auth-brand-name">
                        NHÀ HÀNG
                        <small>GẮN KẾT QUA TỪNG BỮA ĂN</small>
                    </span>
                </a>
                <h1 class="auth-title">Đăng ký thành viên</h1>
                <p class="auth-subtitle">Tạo tài khoản để đặt bàn nhanh chóng và hưởng nhiều ưu đãi độc quyền</p>
            </div>

            <!-- Thông báo thành công / thất bại -->
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="auth-alert auth-alert-success" role="alert">
                    <svg class="auth-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <div>
                        <strong>Chúc mừng!</strong> @ViewBag.SuccessMessage
                        <div style="font-size: 12.5px; margin-top: 4px; opacity: 0.9;">Hệ thống sẽ chuyển hướng đến trang đăng nhập sau vài giây...</div>
                    </div>
                </div>
                <script>
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Login", "Account")';
                    }, 2500);
                </script>
            }

            @if (ViewBag.FailMessage != null)
            {
                <div class="auth-alert auth-alert-danger" role="alert">
                    <svg class="auth-alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <div>
                        <strong>Đăng ký không thành công:</strong> @ViewBag.FailMessage
                    </div>
                </div>
            }

            <!-- Form đăng ký -->
            <form id="registerForm" class="auth-form" method="post" asp-controller="Account" asp-action="Register">
                
                <!-- Section 1: Thông tin cá nhân -->
                <div class="auth-section-title">Thông tin cá nhân</div>
                <div class="auth-grid auth-grid-2">
                    <div class="auth-group auth-col-full">
                        <label class="auth-label" for="hoTen">
                            Họ và tên <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <input id="hoTen" 
                                   name="hoTen" 
                                   class="auth-input" 
                                   placeholder="Ví dụ: Nguyễn Văn A" 
                                   required 
                                   maxlength="250" 
                                   autocomplete="name" />
                        </div>
                    </div>

                    <div class="auth-group">
                        <label class="auth-label" for="ngaySinh">
                            Ngày sinh <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <input id="ngaySinh" 
                                   name="ngaySinh" 
                                   type="date" 
                                   class="auth-input" 
                                   required 
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" 
                                   autocomplete="bday" />
                        </div>
                    </div>

                    <div class="auth-group">
                        <label class="auth-label" for="gioiTinh">
                            Giới tính <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 8v8M8 12h8"></path>
                            </svg>
                            <select id="gioiTinh" name="gioiTinh" class="auth-select" required>
                                <option value="" disabled selected>Chọn giới tính</option>
                                <option value="true">Nam</option>
                                <option value="false">Nữ</option>
                            </select>
                        </div>
                    </div>

                    <div class="auth-group">
                        <label class="auth-label" for="soDienThoai">
                            Số điện thoại <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                            <input id="soDienThoai" 
                                   name="soDienThoai" 
                                   type="tel" 
                                   class="auth-input" 
                                   placeholder="09xx xxx xxx" 
                                   required 
                                   autocomplete="tel" />
                        </div>
                    </div>

                    <div class="auth-group">
                        <label class="auth-label" for="diaChi">
                            Địa chỉ <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <input id="diaChi" 
                                   name="diaChi" 
                                   class="auth-input" 
                                   placeholder="Số nhà, đường, quận/huyện..." 
                                   required 
                                   autocomplete="street-address" />
                        </div>
                    </div>
                </div>

                <!-- Section 2: Thông tin tài khoản -->
                <div class="auth-section-title" style="margin-top: 12px;">Thông tin tài khoản</div>
                <div class="auth-grid auth-grid-2">
                    <div class="auth-group">
                        <label class="auth-label" for="username">
                            Tên đăng nhập <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="8.5" cy="7" r="4"></circle>
                                <line x1="20" y1="8" x2="20" y2="14"></line>
                                <line x1="23" y1="11" x2="17" y2="11"></line>
                            </svg>
                            <input id="username" 
                                   name="username" 
                                   class="auth-input" 
                                   placeholder="Tối đa 50 ký tự" 
                                   required 
                                   maxlength="50" 
                                   autocomplete="username" />
                        </div>
                    </div>

                    <div class="auth-group">
                        <label class="auth-label" for="email">
                            Email <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <input id="email" 
                                   name="email" 
                                   type="email" 
                                   class="auth-input" 
                                   placeholder="name@example.com" 
                                   required 
                                   maxlength="50" 
                                   autocomplete="email" />
                        </div>
                    </div>

                    <div class="auth-group">
                        <label class="auth-label" for="password">
                            Mật khẩu <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <input id="password" 
                                   name="password" 
                                   type="password" 
                                   class="auth-input" 
                                   placeholder="Tối thiểu 6 ký tự" 
                                   required 
                                   autocomplete="new-password" />
                            <button type="button" class="auth-password-toggle" onclick="togglePasswordVisibility('password', this)" aria-label="Hiện/Ẩn mật khẩu">
                                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-closed" style="display: none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="auth-group">
                        <label class="auth-label" for="confirmPassword">
                            Nhập lại mật khẩu <span class="required-mark">*</span>
                        </label>
                        <div class="auth-input-wrap">
                            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 2l-2 2m-1-1l-3 3m5 8l-2 2-3-3 2-2 3 3z"></path>
                                <circle cx="7.5" cy="16.5" r="4.5"></circle>
                            </svg>
                            <input id="confirmPassword" 
                                   name="confirmPassword" 
                                   type="password" 
                                   class="auth-input" 
                                   placeholder="Khớp với mật khẩu trên" 
                                   required 
                                   autocomplete="new-password" />
                            <button type="button" class="auth-password-toggle" onclick="togglePasswordVisibility('confirmPassword', this)" aria-label="Hiện/Ẩn mật khẩu">
                                <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <svg class="eye-closed" style="display: none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                    <line x1="1" y1="1" x2="23" y2="23"></line>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <p class="auth-terms">
                    Bằng việc nhấn "Tạo tài khoản", bạn đồng ý với các quy định và chính sách phục vụ của nhà hàng.
                </p>

                <button type="submit" class="auth-btn-primary">
                    Tạo tài khoản
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </button>
            </form>

            <div class="auth-footer">
                Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập ngay</a>
            </div>
        </div>
    </div>

    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const eyeOpen = btn.querySelector('.eye-open');
            const eyeClosed = btn.querySelector('.eye-closed');
            
            if (input.type === 'password') {
                input.type = 'text';
                eyeOpen.style.display = 'none';
                eyeClosed.style.display = 'block';
            } else {
                input.type = 'password';
                eyeOpen.style.display = 'block';
                eyeClosed.style.display = 'none';
            }
        }

        // Kiểm tra khớp mật khẩu client-side
        const form = document.getElementById('registerForm');
        const pass = document.getElementById('password');
        const confirmPass = document.getElementById('confirmPassword');

        form.addEventListener('submit', function(e) {
            if (pass.value !== confirmPass.value) {
                e.preventDefault();
                alert('Mật khẩu xác nhận không khớp. Vui lòng nhập lại!');
                confirmPass.focus();
            }
        });
    </script>
</body>
</html>
