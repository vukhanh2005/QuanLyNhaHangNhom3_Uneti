@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        label{
            display: inline-block;
            min-width: 120px;
        }
        body{
            width: 100%;
            height: 100vh;
            display: flex;

            justify-content: center;
            align-items: center;

        }
        .wrapper{
            border: 2px black solid;
            border-radius: 50px;
            padding: 20px;
            width: fit-content;
            height: fit-content;
        }
        .input-register-box{
            margin-top: 10px;
            margin-bottom: 10px;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .button-box{
            display: flex;
            justify-content: center;
            margin-top: 10px;
        }
        button{
            border-radius: 50px;
            width: 100px;
            height: 50px;
        }
        input{
            border-radius: 10px;
            padding-left: 10px;
            height: 100%;
        }
        .register-form{
            display: flex;
            justify-content: center;
            align-items: center;

            flex-direction: column;
        }
        .success-message{
            color: green;
            font-size: larger;
        }
        .fail-message{
            color: red;
            font-size: larger;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        @{
            if(ViewBag.SuccessMessage != null)
            {
                //Dang ki thanh cong thi chuyen huong den trang dang nhap
                <b>
                    <p class="success-message">
                        @ViewBag.SuccessMessage
                    </p>
                </b>
                <script>
                    setTimeout(()=>{
                        window.location.href = '@Url.Action("Login", "Account")';
                    }, 3000)
                </script>
            }
            if(ViewBag.FailMessage != null)
            {
                <b>
                    <p class="fail-message">
                        @ViewBag.FailMessage
                    </p>
                </b>
            }
        }
        <form class="register-form" method="post" asp-controller="Account" asp-action="Register">
            <div class="input-register-box">
                <label>Ho Va Ten</label>
                <input required name="hoTen"/>
            </div>
            <div class="input-register-box">
                <label>Email</label>
                <input type="email" required name="email"/>
            </div>
            <div class="input-register-box">
                <label>Ten dang nhap</label>
                <input required name="username"/>
            </div>
            <div class="input-register-box">
                <label>Mat khau</label>
                <input required name="password" type="password"/>
            </div>
            <div class="input-register-box">
                <label>Nhap lai mat khau</label>
                <input type="password" required name="confirmPassword"/>
            </div>
            <div class="button-box">
                <button>Dang ki</button>
            </div>
        </form>
    </div>
</body>
</html>