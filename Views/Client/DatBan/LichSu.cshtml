@model List<QuanLyNhaHang.Models.PhieuDatBan>

@{
    ViewData["Title"] = "Lịch sử đặt bàn";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Lịch sử đặt bàn</h2>
            <p class="text-muted mb-0">
                Danh sách các phiếu đặt bàn theo tài khoản của bạn.
            </p>
        </div>

        <a asp-controller="DatBan"
           asp-action="Index"
           class="btn btn-outline-primary">
            Đặt bàn mới
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Bàn</th>
                        <th>Ngày giờ đặt</th>
                        <th>Số người</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var phieu in Model)
                    {
                        <tr>
                            <td>@phieu.MaPhieuDatBan</td>
                            <td>
                                @(phieu.BanAn?.TenBan ?? "Không có dữ liệu")
                            </td>
                            <td>
                                @phieu.NgayGioDat.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>@phieu.SoNguoi</td>
                            <td>
                                @if (phieu.TrangThai == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning text-dark">
                                        @phieu.TrangThai
                                    </span>
                                }
                                else if (phieu.TrangThai == "Đã xác nhận")
                                {
                                    <span class="badge bg-success">
                                        @phieu.TrangThai
                                    </span>
                                }
                                else if (phieu.TrangThai == "Đã hủy")
                                {
                                    <span class="badge bg-danger">
                                        @phieu.TrangThai
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @phieu.TrangThai
                                    </span>
                                }
                            </td>
                            <td>@phieu.GhiChu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Bạn chưa có phiếu đặt bàn nào.
        </div>
    }

    <a asp-controller="TrangChu"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Về trang chủ
    </a>
</div>
